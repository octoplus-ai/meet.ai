# 1) Conseguí tu API key en https://console.anthropic.com/  (sección API Keys)
# 2) Renombrá este archivo a  .env  y pegá tu key abajo (sin comillas)
# Sin esta key, la app abre igual pero "Analizar reunion" y el chat no responden.
ANTHROPIC_API_KEY=

# Server-only playback of historical in-house recordings. These credentials must
# access R2_BUCKET; keep them separate from the token scoped to R2_PRIVATE_BUCKET.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_LEGACY_ACCESS_KEY_ID=
R2_LEGACY_SECRET_ACCESS_KEY=
